{
  "title": "MCP Security - Cost by Tenant",
  "uid": "mcp-cost-by-tenant",
  "version": 1,
  "schemaVersion": 38,
  "time": { "from": "now-24h", "to": "now" },
  "refresh": "5m",
  "panels": [
    {
      "id": 1,
      "title": "Bedrock Token Usage by Tenant",
      "type": "bargauge",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (increase(bedrock_tokens_total[24h]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "API Calls by Tenant (24h)",
      "type": "table",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (increase(http_server_requests_total{service=\"mcp-api\"}[24h]))",
          "legendFormat": "{{tenant_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Estimated Cost Trend (USD)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 24, "h": 8 },
      "targets": [
        {
          "expr": "sum by (tenant_id) (rate(bedrock_tokens_total[1h]) * 0.000003)",
          "legendFormat": "{{tenant_id}} $/hr"
        }
      ]
    }
  ]
}
