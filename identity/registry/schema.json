{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcp-security-control-plane/schemas/agent-identity/v1",
  "title": "AgentIdentity",
  "description": "Schema for an MCP agent identity record in the registry",
  "type": "object",
  "required": ["agent_id", "name", "tier", "tool_grants", "issuer", "is_active"],
  "properties": {
    "agent_id": {
      "type": "string",
      "description": "Unique identifier for the agent",
      "pattern": "^[a-z0-9][a-z0-9-]{2,62}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "description": "Human-readable agent name",
      "minLength": 1,
      "maxLength": 255
    },
    "tier": {
      "type": "string",
      "enum": ["T0", "T1", "T2"],
      "description": "Agent privilege tier"
    },
    "tool_grants": {
      "type": "array",
      "items": { "type": "string" },
      "description": "List of tool names this agent is authorized to call"
    },
    "description": {
      "type": "string",
      "description": "Description of the agent's purpose"
    },
    "issuer": {
      "type": "string",
      "description": "Token issuer identifier"
    },
    "is_active": {
      "type": "boolean",
      "description": "Whether this agent identity is currently active"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp when the identity was created"
    },
    "expires_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "description": "ISO 8601 timestamp when the identity expires (null = no expiry)"
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata for the agent identity"
    }
  },
  "additionalProperties": false
}
