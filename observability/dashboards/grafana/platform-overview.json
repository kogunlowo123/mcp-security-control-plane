{
  "title": "MCP Security Control Plane - Platform Overview",
  "uid": "mcp-platform-overview",
  "version": 1,
  "schemaVersion": 38,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "API Request Rate",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "rate(http_server_requests_total{service=\"mcp-api\"}[5m])",
          "legendFormat": "{{method}} {{route}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Authorization Decisions",
      "type": "piechart",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum by (decision) (increase(mcp_authorization_decisions_total[1h]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Violation Rate",
      "type": "stat",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "rate(mcp_violations_total[5m]) * 60",
          "legendFormat": "violations/min"
        }
      ]
    },
    {
      "id": 4,
      "title": "Agent Execution Time P99",
      "type": "gauge",
      "gridPos": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, rate(agent_execution_duration_seconds_bucket[5m]))",
          "legendFormat": "P99"
        }
      ]
    },
    {
      "id": 5,
      "title": "API Error Rate",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 4 },
      "targets": [
        {
          "expr": "rate(http_server_requests_total{status=~\"5..\",service=\"mcp-api\"}[5m])",
          "legendFormat": "5xx errors"
        }
      ]
    }
  ]
}
